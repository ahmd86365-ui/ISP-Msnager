# Environment: development | test | production
NODE_ENV=development

# PostgreSQL connection string used by Prisma / the Next.js app.
# Keep the credentials/db name in sync with the POSTGRES_* values below,
# which are used by docker-compose.yml for local development.
DATABASE_URL="postgresql://isp_manager:isp_manager@localhost:5434/isp_manager?schema=public"

# Local Docker Compose PostgreSQL service settings
# Port defaults to 5434 (not 5432) to avoid clashing with other local Postgres instances.
POSTGRES_USER=isp_manager
POSTGRES_PASSWORD=isp_manager
POSTGRES_DB=isp_manager
POSTGRES_PORT=5434

# Secret used by Auth.js to sign/encrypt session JWTs. Required, at least 32
# characters. Generate a real value locally with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Never commit a real secret — this is a placeholder only.
AUTH_SECRET="replace-with-a-generated-32+-character-secret"
